{% if request.page_type == 'collection' and collection.handle == 'all-bundles' %}
  {% if customer %}
  <script>
    (function () {
      var bundleHandle = {{ collection.handle | json }};
      var returnPath = {{ request.path | json }};
      var loginUrl = '/account/login?return_url=' + encodeURIComponent(returnPath);
      var customerEmail = {{ customer.email | json }};
      var customerId = {{ customer.id | json }};
      var shopDomain = {{ shop.permanent_domain | json }};
      var accessUrl =
        '/apps/student-register/bundle-access?collection=' +
        encodeURIComponent(bundleHandle) +
        '&customer_email=' +
        encodeURIComponent(customerEmail) +
        '&logged_in_customer_id=' +
        encodeURIComponent(customerId) +
        '&shop=' +
        encodeURIComponent(shopDomain);

      function hideBundleLinks() {
        document.querySelectorAll('a[href*="/collections/' + bundleHandle + '"]').forEach(function (anchor) {
          anchor.setAttribute('aria-hidden', 'true');
          anchor.style.display = 'none';
        });
      }

      function enforceAccess(allowed) {
        if (allowed) return;
        window.location.replace(loginUrl);
      }

      fetch(accessUrl, {
        credentials: 'same-origin',
        headers: { 'Accept': 'application/json' },
        method: 'GET',
        cache: 'no-store',
      })
        .then(function (response) {
          return response.ok ? response.json() : Promise.reject(new Error('unauthorized'));
        })
        .then(function (data) {
          if (!data || !data.allowed) {
            window.location.replace(loginUrl);
            return;
          }
          hideBundleLinks();
        })
        .catch(function () {
          window.location.replace(loginUrl);
        });

      hideBundleLinks();

      var observer = new MutationObserver(hideBundleLinks);
      observer.observe(document.documentElement, { childList: true, subtree: true });
      setTimeout(function () {
        observer.disconnect();
      }, 10000);
    })();
  </script>
  {% else %}
    <script>
      window.location.replace('/account/login?return_url=' + encodeURIComponent({{ request.path | json }}));
    </script>
  {% endif %}
{% endif %}

{% schema %}
{
  "name": "Bundle Access Guard",
  "target": "body",
  "settings": []
}
{% endschema %}
