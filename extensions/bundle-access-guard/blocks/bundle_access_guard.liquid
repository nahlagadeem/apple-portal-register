{% if request.page_type == 'collection' and collection.handle == 'all-bundles' %}
  <script>
    (function () {
      var bundleHandle = {{ collection.handle | json }};
      var returnPath = {{ request.path | json }};
      var loginUrl = '/account/login?return_url=' + encodeURIComponent(returnPath);

      function hideBundleLinks() {
        document.querySelectorAll('a[href*="/collections/' + bundleHandle + '"]').forEach(function (anchor) {
          anchor.setAttribute('aria-hidden', 'true');
          anchor.style.display = 'none';
        });
      }

      function enforceAccess(allowed) {
        if (allowed) return;
        window.location.replace(loginUrl);
      }

      fetch('/apps/student-register/bundle-access?collection=' + encodeURIComponent(bundleHandle), {
        credentials: 'same-origin',
        headers: { 'Accept': 'application/json' },
      })
        .then(function (response) {
          if (!response.ok) return { allowed: false };
          return response.json();
        })
        .then(function (data) {
          enforceAccess(Boolean(data && data.allowed));
          if (!data || !data.allowed) hideBundleLinks();
        })
        .catch(function () {
          enforceAccess(false);
        });

      hideBundleLinks();

      var observer = new MutationObserver(hideBundleLinks);
      observer.observe(document.documentElement, { childList: true, subtree: true });
      setTimeout(function () {
        observer.disconnect();
      }, 10000);
    })();
  </script>
{% endif %}

{% schema %}
{
  "name": "Bundle Access Guard",
  "target": "body",
  "settings": []
}
{% endschema %}
